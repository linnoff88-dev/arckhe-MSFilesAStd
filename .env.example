# =============================================
# CONFIGURACAO DE APIs - LLMs E IMAGENS
# =============================================
# Copie este arquivo para .env e preencha suas chaves
# cp .env.example .env

# =============================================
# LLMs (Texto)
# =============================================

# OpenAI (GPT-4, GPT-3.5, Codex, DALL-E)
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_ORG_ID=org-xxxxxxxx
OPENAI_MODEL=gpt-4

# Anthropic (Claude)
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-3-opus-20240229

# Google (Gemini)
# Obtenha em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_MODEL=gemini-pro

# OpenRouter (acesso a TODAS as LLMs por uma unica API)
# Obtenha em: https://openrouter.ai/keys
# Modelos: openai/gpt-4, anthropic/claude-3, meta-llama/llama-3, mistralai/mistral-large
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-4

# Together AI (Llama, Mistral, etc - mais barato)
# Obtenha em: https://api.together.xyz/
TOGETHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TOGETHER_MODEL=meta-llama/Llama-3-70b-chat-hf

# Azure OpenAI (opcional - para empresas)
AZURE_OPENAI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# =============================================
# GERACAO DE IMAGENS
# =============================================

# Banana.dev (deploy de modelos ML)
# Obtenha em: https://www.banana.dev/
# 1. Crie conta em banana.dev
# 2. Va em Dashboard > API Keys
# 3. Copie a API Key
# 4. Para MODEL_KEY: va em Models > escolha um modelo > copie o Model Key
BANANA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BANANA_MODEL_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Replicate (Stable Diffusion, FLUX, etc)
# Obtenha em: https://replicate.com/account/api-tokens
# Modelos populares:
# - stability-ai/sdxl (Stable Diffusion XL)
# - black-forest-labs/flux-schnell (FLUX rapido)
# - black-forest-labs/flux-pro (FLUX qualidade)
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================
# MODELOS DE IMAGEM RECOMENDADOS
# =============================================
#
# REPLICATE (mais facil de usar):
#   - stability-ai/sdxl:latest          -> Stable Diffusion XL
#   - black-forest-labs/flux-schnell    -> FLUX rapido (gratis)
#   - black-forest-labs/flux-pro        -> FLUX alta qualidade
#   - stability-ai/stable-diffusion     -> SD classico
#
# BANANA.DEV (mais customizavel):
#   - Precisa escolher modelo no dashboard
#   - Suporta modelos custom
#
# OPENAI:
#   - dall-e-3                          -> DALL-E 3
#   - dall-e-2                          -> DALL-E 2
